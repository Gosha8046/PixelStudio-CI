@* Minimal inline SVG icon set drawn for this project (16x16 grid, stroke-based). *@
<svg class="ps-icon" viewBox="0 0 16 16" width="@Size" height="@Size" aria-hidden="true" focusable="false">
  @switch (Name)
  {
    case "pencil":
      <path d="M3 13l1-3 7-7 2 2-7 7-3 1z" /><path d="M10 4l2 2" />
      break;
    case "eraser":
      <path d="M2.5 11.5l6-6 4 4-4 4H5z" /><path d="M8.5 13.5H14" /><path d="M5.5 8.5l4 4" />
      break;
    case "fill":
      <path d="M3 8l5-5 5 5-5 5z" /><path d="M13.5 10.5c.8 1 .8 2.5 0 2.5s-.8-1.5 0-2.5z" />
      break;
    case "eyedropper":
      <path d="M10 2.5l3.5 3.5-2 2-3.5-3.5z" /><path d="M8.5 5.5l-5.5 5.5v2h2l5.5-5.5" />
      break;
    case "hand":
      <path d="M5 8V4.5a1 1 0 012 0V7m0-3a1 1 0 012 0v3m0-2a1 1 0 012 0v4c0 3-1.5 4.5-4 4.5S4 13 3 11L2.5 9a1 1 0 011.8-.8L5 9" />
      break;
    case "plus":
      <path d="M8 3v10M3 8h10" />
      break;
    case "copy":
      <rect x="5.5" y="5.5" width="8" height="8" rx="1" /><path d="M10.5 3.5v-1h-8v8h1" />
      break;
    case "trash":
      <path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.7 8.5h5.6l.7-8.5" />
      break;
    case "up":
      <path d="M8 13V3M4 7l4-4 4 4" />
      break;
    case "down":
      <path d="M8 3v10M4 9l4 4 4-4" />
      break;
    case "left":
      <path d="M13 8H3M7 4L3 8l4 4" />
      break;
    case "right":
      <path d="M3 8h10M9 4l4 4-4 4" />
      break;
    case "merge":
      <path d="M4 3v3l4 4 4-4V3M8 10v3.5" />
      break;
    case "eye":
      <path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z" /><circle cx="8" cy="8" r="2" />
      break;
    case "eye-off":
      <path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z" opacity=".35" /><path d="M2.5 13.5l11-11" />
      break;
    case "play":
      <path d="M5 3l8 5-8 5z" />
      break;
    case "pause":
      <path d="M5 3v10M11 3v10" />
      break;
    case "prev":
      <path d="M4 3v10M12 3L6 8l6 5z" />
      break;
    case "next":
      <path d="M12 3v10M4 3l6 5-6 5z" />
      break;
    case "loop":
      <path d="M3 9V7a3 3 0 013-3h6M10 2l2 2-2 2M13 7v2a3 3 0 01-3 3H4M6 14l-2-2 2-2" />
      break;
    case "new":
      <path d="M4 1.5h5l3 3v10H4z" /><path d="M8 7v5M5.5 9.5h5" />
      break;
    case "open":
      <path d="M1.5 4.5V13h11l2-6h-11l-2 6M1.5 4.5V3h4l1.5 1.5h5V7" />
      break;
    case "save":
      <path d="M2.5 2.5h9l2 2v9h-11z" /><path d="M5 2.5v4h6v-4M5 13.5v-4h6v4" />
      break;
    case "export":
      <path d="M8 10V2M5 5l3-3 3 3M3 9v4.5h10V9" />
      break;
    case "undo":
      <path d="M5 3L2 6l3 3" /><path d="M2 6h7a4 4 0 010 8H6" />
      break;
    case "redo":
      <path d="M11 3l3 3-3 3" /><path d="M14 6H7a4 4 0 000 8h3" />
      break;
    case "grid":
      <path d="M2 2h12v12H2zM6 2v12M10 2v12M2 6h12M2 10h12" />
      break;
    case "crosshair":
      <rect x="6" y="6" width="4" height="4" /><path d="M8 1v3M8 12v3M1 8h3M12 8h3" />
      break;
    case "zoom-in":
      <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5l3.5 3.5M5 7h4M7 5v4" />
      break;
    case "zoom-out":
      <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5l3.5 3.5M5 7h4" />
      break;
    case "fit":
      <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" />
      break;
    case "onion":
      <circle cx="6" cy="8" r="4" opacity=".5" /><circle cx="10" cy="8" r="4" />
      break;
    case "tile":
      <path d="M1.5 1.5h13v13h-13zM5.8 1.5v13M10.2 1.5v13M1.5 5.8h13M1.5 10.2h13" />
      break;
  }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
}
