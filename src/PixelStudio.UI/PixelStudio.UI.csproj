<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Shared editor UI (Razor components + a small JS module for canvas drawing and input).
    Hosted by PixelStudio.Web (Blazor WebAssembly, browser) and PixelStudio.Windows
    (WinForms BlazorWebView / WebView2). Contains no platform file-system code: hosts plug
    in IFileService / IPlatformShell implementations.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelStudio.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelStudio.Core\PixelStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PixelStudio.Tests" />
  </ItemGroup>

</Project>
